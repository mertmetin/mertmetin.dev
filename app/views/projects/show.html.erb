<% content_for :title, @project.name %>
<% content_for :description, @project.tagline %>

<article class="pt-8 sm:pt-12">
  <nav aria-label="Breadcrumb" class="font-mono text-sm text-ink-3">
    <%= link_to "~", root_path, class: "text-accent-ink hover:underline" %> /
    <%= link_to "projects", root_path(anchor: "work"), class: "hover:text-ink" %> /
    <span class="text-ink"><%= @project.slug %></span>
  </nav>

  <div class="mt-6 overflow-hidden rounded-xl border border-line bg-card">
    <%# Repo header %>
    <div class="flex flex-wrap items-center justify-between gap-3 border-b border-line px-5 py-3 font-mono text-[13px]">
      <span class="text-cyan"><%= @project.repo %></span>
      <span class="flex items-center gap-3 text-ink-3">
        <span class="flex items-center gap-1.5"><span class="size-2.5 rounded-full" style="background: <%= @project.language_color %>" aria-hidden="true"></span><%= @project.language %></span>
        <span class="rounded-full border border-line px-2 py-0.5 text-[11px]"><%= @project.private? ? "Private" : "Public" %></span>
      </span>
    </div>
    <div class="flex items-center gap-2 border-b border-line bg-paper/50 px-5 py-2.5 font-mono text-xs text-ink-2">
      <svg viewBox="0 0 16 16" class="size-3.5 fill-ink-3" aria-hidden="true"><path d="M0 1.75A.75.75 0 0 1 .75 1h4.253c1.227 0 2.317.59 3 1.501A3.743 3.743 0 0 1 11.006 1h4.245a.75.75 0 0 1 .75.75v10.5a.75.75 0 0 1-.75.75h-4.507a2.25 2.25 0 0 0-1.591.659l-.622.621a.75.75 0 0 1-1.06 0l-.622-.621A2.25 2.25 0 0 0 5.258 13H.75a.75.75 0 0 1-.75-.75Zm7.251 10.324.004-5.073-.002-2.253A2.25 2.25 0 0 0 5.003 2.5H1.5v9h3.757a3.75 3.75 0 0 1 1.994.574ZM8.755 4.75l-.004 7.322a3.752 3.752 0 0 1 1.992-.572H14.5v-9h-3.495a2.25 2.25 0 0 0-2.25 2.25Z"/></svg>
      README.md
    </div>

    <div class="grid gap-10 p-6 sm:p-8 md:grid-cols-[2fr_1fr]">
      <div>
        <p class="font-mono text-xs text-accent-ink"><%= @project.year %></p>
        <h1 class="mt-2 text-3xl font-semibold tracking-tight sm:text-4xl"><%= @project.name %></h1>
        <p class="mt-2 text-lg text-ink-2 text-pretty"><%= @project.tagline %></p>

        <p class="mt-6 leading-relaxed text-ink-2 text-pretty"><%= @project.summary %></p>

        <h2 class="mt-10 mb-4 font-mono text-sm text-ink-3"><span class="text-accent-ink">##</span> highlights</h2>
        <ul class="space-y-3">
          <% @project.highlights.each do |item| %>
            <li class="flex gap-3 leading-relaxed">
              <span class="font-mono text-accent-ink" aria-hidden="true">›</span>
              <span><%= item %></span>
            </li>
          <% end %>
        </ul>
      </div>

      <aside class="space-y-6">
        <div class="rounded-lg border border-line bg-paper/60 px-4 py-4">
          <p class="font-mono text-2xl font-semibold tracking-tight tabular-nums text-accent-ink"><%= @project.stat %></p>
          <p class="mt-1 text-xs text-ink-3"><%= @project.stat_label %></p>
        </div>

        <div>
          <h2 class="mb-3 font-mono text-xs uppercase tracking-wider text-ink-3">built with</h2>
          <ul class="flex flex-wrap gap-1.5">
            <% @project.stack.each do |tech| %>
              <li class="rounded-md border border-line bg-tint px-2 py-0.5 font-mono text-xs text-ink-2"><%= tech %></li>
            <% end %>
          </ul>
        </div>

        <div>
          <h2 class="mb-3 font-mono text-xs uppercase tracking-wider text-ink-3">repositories</h2>
          <% if @project.links.any? %>
            <ul class="space-y-2 font-mono text-sm">
              <% @project.links.each do |link| %>
                <li><%= link_to link.url, class: "text-cyan hover:underline" do %><%= link.label %> <span aria-hidden="true" class="text-ink-3">↗</span><% end %></li>
              <% end %>
            </ul>
          <% else %>
            <p class="text-sm text-ink-2">Private: it runs a live business. Happy to walk through it in an interview.</p>
          <% end %>
        </div>
      </aside>
    </div>
  </div>
</article>
