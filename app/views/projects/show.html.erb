<% content_for :title, @project.name %>
<% content_for :description, @project.tagline %>

<article class="pt-6 sm:pt-10">
  <%= link_to "← All work", root_path(anchor: "work"), class: "text-sm text-ink-3 hover:text-ink" %>

  <header class="mt-6 max-w-3xl">
    <p class="text-sm font-medium text-accent-ink"><%= @project.year %></p>
    <h1 class="mt-2 text-4xl font-semibold tracking-tight sm:text-5xl"><%= @project.name %></h1>
    <p class="mt-3 text-xl text-ink-2 text-pretty"><%= @project.tagline %></p>
  </header>

  <div class="mt-10 grid gap-10 md:grid-cols-[2fr_1fr]">
    <div>
      <p class="text-lg leading-relaxed text-ink-2 text-pretty"><%= @project.summary %></p>

      <h2 class="mt-10 mb-4 text-sm font-semibold uppercase tracking-wider text-ink-3">Highlights</h2>
      <ul class="space-y-3">
        <% @project.highlights.each do |item| %>
          <li class="flex gap-3 leading-relaxed">
            <span class="mt-2.5 size-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true"></span>
            <span><%= item %></span>
          </li>
        <% end %>
      </ul>
    </div>

    <aside class="space-y-8">
      <div class="rounded-2xl border border-line bg-card p-6">
        <p class="text-3xl font-semibold tracking-tight tabular-nums"><%= @project.stat %></p>
        <p class="mt-1 text-sm text-ink-3"><%= @project.stat_label %></p>
      </div>

      <div>
        <h2 class="mb-3 text-sm font-semibold uppercase tracking-wider text-ink-3">Built with</h2>
        <ul class="flex flex-wrap gap-1.5">
          <% @project.stack.each do |tech| %>
            <li class="rounded-full bg-tint px-2.5 py-0.5 text-sm text-ink-2"><%= tech %></li>
          <% end %>
        </ul>
      </div>

      <div>
        <h2 class="mb-3 text-sm font-semibold uppercase tracking-wider text-ink-3">Code</h2>
        <% if @project.links.any? %>
          <ul class="space-y-2">
            <% @project.links.each do |link| %>
              <li><%= link_to link.label, link.url, class: "font-medium text-accent-ink underline underline-offset-4" %> <span aria-hidden="true" class="text-ink-3">↗</span></li>
            <% end %>
          </ul>
        <% else %>
          <p class="text-ink-2">Private: it runs a live business. Happy to walk through it in an interview.</p>
        <% end %>
      </div>
    </aside>
  </div>
</article>
