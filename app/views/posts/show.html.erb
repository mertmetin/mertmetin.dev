<% content_for :title, @post.title %>
<% content_for :description, @post.summary %>

<article class="mx-auto max-w-2xl pt-8 sm:pt-12">
  <nav aria-label="Breadcrumb" class="font-mono text-sm text-ink-3">
    <%= link_to "~", root_path, class: "text-accent-ink hover:underline" %> /
    <%= link_to "writing", posts_path, class: "hover:text-ink" %> /
    <span class="text-ink"><%= @post.slug %></span>
  </nav>

  <header class="mt-8">
    <p class="font-mono text-xs text-ink-3">
      <time datetime="<%= @post.date.iso8601 %>"><%= @post.date.strftime("%B %-d, %Y") %></time> · <%= @post.reading_minutes %> min read
    </p>
    <h1 class="mt-3 text-3xl font-semibold tracking-tight text-balance sm:text-4xl"><%= @post.title %></h1>
    <p class="mt-3 text-lg text-ink-2 text-pretty"><%= @post.summary %></p>
  </header>

  <div class="prose-post mt-10"><%= @post.html %></div>

  <footer class="mt-14 flex flex-wrap items-center justify-between gap-3 border-t border-line pt-6 font-mono text-sm">
    <%= link_to "← All writing", posts_path, class: "text-ink-2 hover:text-ink" %>
    <span class="text-ink-3"><%= @post.tags.map { "##{_1}" }.join("  ") %></span>
  </footer>
</article>
