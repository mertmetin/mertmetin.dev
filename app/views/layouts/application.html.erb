<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for?(:title) ? "#{yield(:title)} · Mert Metin" : "Mert Metin · Senior Software Engineer" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="<%= content_for?(:description) ? yield(:description) : "Mert Metin, Senior Software Engineer in Ottawa. Full-stack web and mobile apps, search and machine learning." %>">
    <meta name="color-scheme" content="light dark">
    <meta property="og:title" content="<%= content_for?(:title) ? yield(:title) : "Mert Metin" %>">
    <meta property="og:description" content="Senior Software Engineer in Ottawa">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-paper text-ink antialiased">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded-md focus:bg-ink focus:px-3 focus:py-2 focus:text-paper">Skip to content</a>

    <header class="mx-auto flex max-w-5xl items-center justify-between px-4 py-6 sm:px-6">
      <%= link_to root_path, class: "flex items-center gap-2.5 font-semibold tracking-tight" do %>
        <span class="grid size-8 place-items-center rounded-lg bg-accent text-sm font-bold text-white" aria-hidden="true">MM</span>
        <span>Mert Metin</span>
      <% end %>
      <nav aria-label="Main" class="flex items-center gap-1 text-sm text-ink-2">
        <%= link_to "Work", root_path(anchor: "work"), class: "rounded-md px-3 py-2 hover:bg-tint hover:text-ink" %>
        <%= link_to "About", root_path(anchor: "about"), class: "rounded-md px-3 py-2 hover:bg-tint hover:text-ink" %>
        <%= link_to "GitHub", "https://github.com/mertmetin", class: "rounded-md px-3 py-2 hover:bg-tint hover:text-ink", rel: "me" %>
      </nav>
    </header>

    <main id="main" class="mx-auto max-w-5xl px-4 pb-24 sm:px-6">
      <%= yield %>
    </main>

    <footer class="border-t border-line">
      <div class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-3 px-4 py-8 text-sm text-ink-3 sm:px-6">
        <p>© <%= Date.current.year %> Mert Metin · Ottawa</p>
        <p>Built with Ruby on Rails · <%= link_to "Source", "https://github.com/mertmetin/mertmetin.dev", class: "underline decoration-line underline-offset-4 hover:text-ink" %></p>
      </div>
    </footer>
  </body>
</html>
