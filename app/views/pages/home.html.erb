<%# ------------------------------------------------------------------ hero %>
<section class="relative pt-14 pb-20 sm:pt-20 sm:pb-24" aria-labelledby="intro">
  <div class="grid-bg pointer-events-none absolute inset-x-[-50vw] -top-10 bottom-0 -z-10" aria-hidden="true"></div>

  <div class="grid items-center gap-10 lg:grid-cols-[1.15fr_1fr]">
    <div>
      <p class="mb-5 inline-flex items-center gap-2 rounded-full border border-line bg-card px-3 py-1 font-mono text-xs text-ink-2">
        <span class="size-2 rounded-full bg-accent" aria-hidden="true"></span>
        open to senior SWE and ML/AI roles
      </p>
      <h1 id="intro" class="text-4xl font-semibold tracking-tight text-balance sm:text-5xl">
        Mert Metin<span class="text-ink-3">,</span><br>
        <span class="text-ink-2">Senior Software Engineer.</span>
      </h1>
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-ink-2 text-pretty">
        I build full-stack web and mobile products end to end (APIs, apps, payments, cloud) and I
        measure whether they work. Search and machine learning are my favourite problems.
      </p>
      <div class="mt-8 flex flex-wrap gap-3 font-mono text-sm">
        <%= link_to "#work", class: "rounded-md bg-accent px-4 py-2.5 font-semibold text-paper hover:brightness-110" do %>./view-work<% end %>
        <%= link_to "https://github.com/mertmetin", class: "rounded-md border border-line bg-card px-4 py-2.5 font-medium hover:border-ink-3", rel: "me" do %>git clone github.com/mertmetin<% end %>
      </div>
    </div>

    <%# Terminal: interactive with JavaScript, a static transcript without it. %>
    <figure class="overflow-hidden rounded-xl border border-line bg-card shadow-2xl shadow-black/20"
            aria-label="An interactive terminal: type help to see the commands"
            data-controller="terminal"
            data-terminal-projects-value="<%= @projects.map { |p| { slug: p.slug, name: p.name, tagline: p.tagline, stat: p.stat, stat_label: p.stat_label, url: project_path(p) } }.to_json %>"
            data-terminal-github-url-value="https://github.com/mertmetin"
            data-action="click->terminal#focus">
      <div class="flex items-center gap-2 border-b border-line px-4 py-3">
        <span class="size-3 rounded-full bg-[#ff5f57]" aria-hidden="true"></span>
        <span class="size-3 rounded-full bg-[#febc2e]" aria-hidden="true"></span>
        <span class="size-3 rounded-full bg-[#28c840]" aria-hidden="true"></span>
        <span class="ml-2 font-mono text-xs text-ink-3">mert@ottawa: ~</span>
      </div>

      <div class="h-[19rem] font-mono text-[12.5px] leading-6 text-ink-2 sm:text-[13px]">
        <div data-terminal-target="output" class="h-[calc(100%-2.75rem)] overflow-y-auto px-5 pt-4 break-words" role="log" aria-live="polite" hidden></div>
        <form data-terminal-target="form" data-action="submit->terminal#submit" class="flex items-center gap-2 px-5 pb-4" hidden>
          <label for="terminal-input" class="text-accent-ink">$</label>
          <input id="terminal-input" data-terminal-target="input" data-action="keydown->terminal#keydown"
                 class="min-w-0 flex-1 bg-transparent text-ink caret-accent outline-none placeholder:text-ink-3"
                 autocomplete="off" autocapitalize="off" spellcheck="false" enterkeyhint="go"
                 placeholder="type help" aria-label="Terminal command">
        </form>

        <div data-terminal-target="game" class="h-full px-4 pt-3 pb-2" hidden>
          <div class="mb-2 flex items-center justify-between text-xs text-ink-3">
            <span>🐇 rabbit run · delivered <span data-terminal-target="score" class="text-accent-ink">0</span></span>
            <span class="hidden sm:inline">arrows / WASD · esc to quit</span>
            <span class="sm:hidden">swipe · <button type="button" class="underline" data-action="terminal#quitGame">quit</button></span>
          </div>
          <canvas data-terminal-target="canvas" class="block w-full touch-none rounded-md"
                  data-action="touchstart->terminal#touchstart touchmove->terminal#touchmove"
                  aria-label="Rabbit Run game board"></canvas>
        </div>

      <pre data-terminal-target="static" class="overflow-x-auto px-5 pt-4 whitespace-pre-wrap lg:whitespace-pre"><span class="text-accent-ink">$</span> <span class="text-ink">whoami</span>
Mert Metin · Senior Software Engineer · Ottawa, ON

<span class="text-accent-ink">$</span> <span class="text-ink">cat stack.txt</span>
<span class="text-cyan">TypeScript</span>  <span class="text-cyan">Python</span>  <span class="text-cyan">Ruby</span>  <span class="text-cyan">PHP</span>
<span class="text-violet">Next.js</span>  <span class="text-violet">React Native</span>  <span class="text-violet">Rails</span>  <span class="text-violet">FastAPI</span>
<span class="text-amber">AWS</span>  <span class="text-amber">Docker</span>  <span class="text-amber">MySQL</span>  <span class="text-amber">Stripe</span>

<span class="text-accent-ink">$</span> <span class="text-ink">ls ~/projects</span>
<% @projects.each do |p| %><%= link_to "#{p.slug}/", project_path(p), class: "text-cyan hover:underline" %>  <% end %>

<span class="text-accent-ink">$</span> <span class="cursor" aria-hidden="true"></span></pre>
      </div>
    </figure>
  </div>
</section>

<%# ------------------------------------------------------------------ work %>
<section id="work" class="scroll-mt-20" aria-labelledby="work-heading">
  <h2 id="work-heading" class="mb-6 font-mono text-sm text-ink-3"><span class="text-accent-ink">//</span> selected work</h2>
  <div class="grid gap-4 md:grid-cols-2">
    <% @projects.each do |project| %>
      <%= link_to project_path(project), class: "group flex flex-col rounded-xl border border-line bg-card p-5 transition hover:border-ink-3 focus-visible:outline-2 focus-visible:outline-accent" do %>
        <div class="flex items-center justify-between gap-3 font-mono text-[13px]">
          <span class="flex min-w-0 items-center gap-2 text-cyan">
            <svg viewBox="0 0 16 16" class="size-4 shrink-0 fill-ink-3" aria-hidden="true"><path d="M2 2.5A2.5 2.5 0 0 1 4.5 0h8.75a.75.75 0 0 1 .75.75v12.5a.75.75 0 0 1-.75.75h-2.5a.75.75 0 0 1 0-1.5h1.75v-2h-8a1 1 0 0 0-.714 1.7.75.75 0 1 1-1.072 1.05A2.495 2.495 0 0 1 2 11.5Zm10.5-1h-8a1 1 0 0 0-1 1v6.708A2.486 2.486 0 0 1 4.5 9h8ZM5 12.25a.25.25 0 0 1 .25-.25h3.5a.25.25 0 0 1 .25.25v3.25a.25.25 0 0 1-.4.2l-1.45-1.087a.249.249 0 0 0-.3 0L5.4 15.7a.25.25 0 0 1-.4-.2Z"/></svg>
            <span class="truncate"><%= project.repo %></span>
          </span>
          <span class="shrink-0 rounded-full border border-line px-2 py-0.5 text-[11px] text-ink-3"><%= project.private? ? "Private" : "Public" %></span>
        </div>

        <h3 class="mt-4 text-lg font-semibold tracking-tight"><%= project.name %></h3>
        <p class="mt-1 text-sm text-ink-2"><%= project.tagline %></p>

        <div class="mt-5 rounded-lg border border-line bg-paper/60 px-4 py-3">
          <p class="font-mono text-2xl font-semibold tracking-tight tabular-nums text-accent-ink"><%= project.stat %></p>
          <p class="mt-0.5 text-xs text-ink-3"><%= project.stat_label %></p>
        </div>

        <div class="mt-5 flex items-center justify-between gap-3 font-mono text-xs text-ink-3">
          <span class="flex items-center gap-1.5">
            <span class="size-2.5 rounded-full" style="background: <%= project.language_color %>" aria-hidden="true"></span>
            <%= project.language %>
          </span>
          <span><%= project.year %></span>
          <span class="text-ink-2 group-hover:text-accent-ink">README.md <span aria-hidden="true">→</span></span>
        </div>
      <% end %>
    <% end %>
  </div>
</section>

<%# ------------------------------------------------------------------ stack %>
<section id="stack" class="scroll-mt-20 pt-24" aria-labelledby="stack-heading">
  <h2 id="stack-heading" class="mb-6 font-mono text-sm text-ink-3"><span class="text-accent-ink">//</span> stack</h2>
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    <% {
         "Languages" => %w[TypeScript Python Ruby PHP SQL],
         "Frameworks" => ["Next.js", "React Native", "Expo", "Rails", "FastAPI", "Laravel"],
         "Data & ML" => ["MySQL", "Prisma", "scikit-learn", "pandas", "Embeddings", "LLM APIs"],
         "Infra" => ["AWS ECS / RDS / S3", "Docker", "GitHub Actions", "Stripe", "Twilio"]
       }.each do |group, items| %>
      <div class="rounded-xl border border-line bg-card p-5">
        <h3 class="font-mono text-xs uppercase tracking-wider text-ink-3"><%= group %></h3>
        <ul class="mt-3 space-y-1.5 text-sm">
          <% items.each do |item| %>
            <li class="flex items-center gap-2"><span class="font-mono text-accent-ink" aria-hidden="true">›</span><%= item %></li>
          <% end %>
        </ul>
      </div>
    <% end %>
  </div>
</section>

<%# ------------------------------------------------------------------ playground %>
<section id="play" class="scroll-mt-20 pt-24" aria-labelledby="play-heading" data-controller="bug-hunt">
  <div class="mb-6 flex flex-wrap items-end justify-between gap-3">
    <div>
      <h2 id="play-heading" class="font-mono text-sm text-ink-3"><span class="text-accent-ink">//</span> playground: bug hunt</h2>
      <p class="mt-2 text-ink-2">Squash the bugs before they reach production. Every one is a real bug I found and fixed.</p>
    </div>
    <dl class="flex gap-5 font-mono text-sm">
      <div><dt class="text-xs text-ink-3">squashed</dt><dd data-bug-hunt-target="score" class="text-accent-ink tabular-nums">0</dd></div>
      <div><dt class="text-xs text-ink-3">shipped</dt><dd data-bug-hunt-target="shipped" class="text-[#f85149] tabular-nums">0</dd></div>
      <div><dt class="text-xs text-ink-3">time</dt><dd data-bug-hunt-target="timer" class="tabular-nums">30s</dd></div>
      <div><dt class="text-xs text-ink-3">best</dt><dd data-bug-hunt-target="best" class="tabular-nums">0</dd></div>
    </dl>
  </div>

  <div class="overflow-hidden rounded-xl border border-line bg-card">
    <div class="flex items-center gap-2 border-b border-line px-4 py-2.5 font-mono text-xs text-ink-3">
      <span class="text-cyan">legacy/social/friends_metro.py</span>
      <span class="ml-auto rounded border border-line px-1.5 py-0.5">main</span>
    </div>

    <div data-bug-hunt-target="board" class="relative h-[23rem] select-none overflow-hidden">
      <%# The real 2019 bug, as the backdrop. %>
      <pre class="pointer-events-none absolute inset-0 overflow-hidden p-5 font-mono text-[12.5px] leading-6 text-ink-3/70" aria-hidden="true"><span class="text-violet">for</span> user <span class="text-violet">in</span> users:
    screen_name = user[<span class="text-amber">3</span>]
    friends = twts.get_friends(screen_name)
    y.append(user_location)
    <span class="rounded bg-[#f85149]/15 px-1 text-ink">cpy = D</span>          <span class="text-ink-3"># copies the reference, not the dict</span>

    <span class="text-violet">for</span> friend <span class="text-violet">in</span> friends:
        places = GeoText(friend[<span class="text-amber">5</span>])
        <span class="text-violet">if</span> places.cities:
            metro = check_metro(places.cities[<span class="text-amber">0</span>])
            cpy[metro] = cpy[metro] + <span class="text-amber">1</span>

    friends_locations.append(cpy)   <span class="text-ink-3"># every row is the same dict</span></pre>

      <%# Production line at the bottom. %>
      <div class="pointer-events-none absolute inset-x-0 bottom-0 flex h-8 items-center justify-center border-t border-dashed border-[#f85149]/60 bg-[#f85149]/10 font-mono text-[11px] tracking-wider text-[#f85149]" aria-hidden="true">
        PRODUCTION
      </div>

      <%# Fact card shown after squashes. %>
      <div data-bug-hunt-target="toast" class="pointer-events-none absolute top-3 right-3 left-3 z-10 max-w-sm rounded-lg border border-line bg-paper/95 p-3 shadow-lg sm:left-auto" role="status" hidden>
        <p class="font-mono text-xs text-accent-ink">fixed: <span data-title></span></p>
        <p class="mt-1 text-sm text-ink-2" data-body></p>
      </div>

      <%# Start / result overlay. %>
      <div data-bug-hunt-target="start" class="absolute inset-0 z-20 grid place-items-center bg-paper/70 p-6 text-center backdrop-blur-[2px]">
        <div>
          <p class="text-4xl" aria-hidden="true">🐛</p>
          <p data-result class="mx-auto mt-3 max-w-sm text-ink-2">30 seconds. Click or tap bugs to squash them. Don't let them ship.</p>
          <button type="button" data-button data-action="bug-hunt#start"
                  class="mt-5 rounded-md bg-accent px-5 py-2.5 font-mono text-sm font-semibold text-paper hover:brightness-110 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent">
            Start bug hunt
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<%# ------------------------------------------------------------------ AI lab %>
<section id="lab" class="scroll-mt-20 pt-24" aria-labelledby="lab-heading" data-controller="rabbit-lab">
  <div class="mb-6 max-w-3xl">
    <h2 id="lab-heading" class="font-mono text-sm text-ink-3"><span class="text-accent-ink">//</span> lab: an AI learns rabbit run</h2>
    <p class="mt-2 text-ink-2">
      This rabbit starts knowing nothing and learns by trial and error: +10 for a grocery, −10 for a crash.
      Pick a brain, press Train, and watch it go from crashing straight into walls to playing better than you,
      right here in your browser. No server, no libraries.
    </p>
    <ul class="mt-3 space-y-1.5 text-sm text-ink-3">
      <li><strong class="font-semibold text-ink-2">Table:</strong> classic Q-learning over 11 yes/no senses. Learns in seconds, but it can only see one cell ahead, so its own trail traps it at around 18 groceries.</li>
      <li><strong class="font-semibold text-ink-2">Neural net:</strong> a Deep Q-Network I wrote from scratch (backprop, Adam, experience replay, target network). It also sees a 5×5 area and how much open space each move leads to, so it avoids traps. In my tests it averaged 73 groceries, 4× the table. Give it 15–30 seconds on Turbo.</li>
    </ul>
  </div>

  <div class="grid gap-4 lg:grid-cols-[1.5fr_1fr]">
    <%# Board and controls %>
    <div class="overflow-hidden rounded-xl border border-line bg-card">
      <div class="flex flex-wrap items-center gap-2 border-b border-line px-4 py-2.5 font-mono text-xs">
        <div role="group" aria-label="Brain" class="flex overflow-hidden rounded-md border border-line">
          <% [["table", "Table"], ["dqn", "Neural net"]].each do |key, label| %>
            <button type="button" data-rabbit-lab-target="brain" data-brain="<%= key %>" data-action="rabbit-lab#setBrain"
                    aria-pressed="<%= key == "table" %>"
                    class="px-2.5 py-1.5 text-ink-2 hover:bg-tint aria-pressed:bg-tint aria-pressed:text-ink"><%= label %></button>
          <% end %>
        </div>
        <button type="button" data-rabbit-lab-target="toggle" data-action="rabbit-lab#toggle" aria-pressed="false"
                class="rounded-md bg-accent px-3 py-1.5 font-semibold text-paper hover:brightness-110 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent">▶ Train</button>
        <div role="group" aria-label="Training speed" class="flex overflow-hidden rounded-md border border-line">
          <% [["watch", "Watch"], ["fast", "Fast"], ["turbo", "Turbo"]].each do |key, label| %>
            <button type="button" data-rabbit-lab-target="speed" data-speed="<%= key %>" data-action="rabbit-lab#setSpeed"
                    aria-pressed="<%= key == "watch" %>"
                    class="px-2.5 py-1.5 text-ink-2 hover:bg-tint aria-pressed:bg-tint aria-pressed:text-ink"><%= label %></button>
          <% end %>
        </div>
        <button type="button" data-action="rabbit-lab#reset" class="ml-auto rounded-md border border-line px-2.5 py-1.5 text-ink-2 hover:bg-tint">Reset brain</button>
      </div>
      <div class="p-4">
        <canvas data-rabbit-lab-target="board" class="block w-full rounded-md" aria-label="The AI playing Rabbit Run"></canvas>
        <p data-rabbit-lab-target="status" class="mt-3 font-mono text-xs text-ink-2" role="status" aria-live="polite"></p>
      </div>
    </div>

    <%# Brain %>
    <div class="space-y-4">
      <dl class="grid grid-cols-3 gap-2 font-mono text-sm">
        <% [["runs", "episode"], ["avg (last 20)", "average"], ["best", "best"], ["exploring", "epsilon"], ["situations seen", "seen"]].each do |label, target| %>
          <div class="rounded-lg border border-line bg-card px-3 py-2 <%= "col-span-2" if target == "seen" %>">
            <dt class="text-[11px] text-ink-3" <%= 'data-rabbit-lab-target="seenLabel"'.html_safe if target == "seen" %>><%= label %></dt>
            <dd data-rabbit-lab-target="<%= target %>" class="mt-0.5 text-lg tabular-nums text-ink">0</dd>
          </div>
        <% end %>
      </dl>

      <div class="rounded-xl border border-line bg-card p-4">
        <h3 class="mb-2 font-mono text-[11px] uppercase tracking-wider text-ink-3">learning curve: score per run, and the 20-run average</h3>
        <canvas data-rabbit-lab-target="curve" class="block h-32 w-full" aria-label="Learning curve"></canvas>
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div class="rounded-xl border border-line bg-card p-4">
          <h3 class="mb-2 font-mono text-[11px] uppercase tracking-wider text-ink-3">what it senses</h3>
          <ul data-rabbit-lab-target="sensors" class="space-y-1 font-mono text-[11px]"></ul>
        </div>
        <div class="rounded-xl border border-line bg-card p-4">
          <h3 class="mb-2 font-mono text-[11px] uppercase tracking-wider text-ink-3">how much it likes each move</h3>
          <div data-rabbit-lab-target="qvalues" class="space-y-2 font-mono text-[11px]"></div>
          <div class="mt-4 space-y-3 border-t border-line pt-3 font-mono text-[11px] text-ink-2">
            <label class="block">
              <span class="flex justify-between"><span>learning rate α</span><output data-rabbit-lab-target="alphaOut">0.10</output></span>
              <input type="range" min="0.01" max="0.5" step="0.01" value="0.1" data-rabbit-lab-target="alpha" data-action="input->rabbit-lab#tune" class="mt-1 w-full accent-accent">
            </label>
            <label class="block">
              <span class="flex justify-between"><span>future reward γ</span><output data-rabbit-lab-target="gammaOut">0.90</output></span>
              <input type="range" min="0.5" max="0.99" step="0.01" value="0.9" data-rabbit-lab-target="gamma" data-action="input->rabbit-lab#tune" class="mt-1 w-full accent-accent">
            </label>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<%# ------------------------------------------------------------------ about %>
<section id="about" class="scroll-mt-20 pt-24" aria-labelledby="about-heading">
  <h2 id="about-heading" class="mb-6 font-mono text-sm text-ink-3"><span class="text-accent-ink">//</span> about</h2>
  <div class="grid gap-10 md:grid-cols-[2fr_1fr]">
    <div class="space-y-5 text-lg leading-relaxed text-ink-2">
      <p>
        I like taking a product from an empty repo to something real people use: designing the data
        model, building the API and the apps on top of it, wiring up payments and notifications, and
        deploying it all with tests and CI behind it.
      </p>
      <p>
        I also care about measuring whether things actually work. When I revisited my 2014 product search
        and my 2019 University of Ottawa thesis, the most useful thing I did was set up honest evaluations,
        which turned up bugs, models that had never learned anything, and an "upgrade" that made results worse.
      </p>
      <p>
        Outside engineering I run a real-estate practice in Ottawa on software I wrote, so I'm used to
        being my own most demanding user.
      </p>
    </div>
    <dl class="h-fit space-y-4 rounded-xl border border-line bg-card p-5 font-mono text-sm">
      <div><dt class="text-xs text-ink-3">location</dt><dd>Ottawa, ON · remote OK</dd></div>
      <div><dt class="text-xs text-ink-3">looking_for</dt><dd>Senior SWE · ML/AI engineering</dd></div>
      <div><dt class="text-xs text-ink-3">education</dt><dd>University of Ottawa</dd></div>
      <div><dt class="text-xs text-ink-3">github</dt><dd><%= link_to "@mertmetin", "https://github.com/mertmetin", class: "text-cyan hover:underline", rel: "me" %></dd></div>
    </dl>
  </div>
</section>
