<%# ------------------------------------------------------------------ hero %>
<section class="relative pt-14 pb-20 sm:pt-20 sm:pb-24" aria-labelledby="intro">
  <div class="grid-bg pointer-events-none absolute inset-x-[-50vw] -top-10 bottom-0 -z-10" aria-hidden="true"></div>

  <div class="grid items-center gap-10 lg:grid-cols-[1.15fr_1fr]">
    <div>
      <p class="mb-5 inline-flex items-center gap-2 rounded-full border border-line bg-card px-3 py-1 font-mono text-xs text-ink-2">
        <span class="size-2 rounded-full bg-accent" aria-hidden="true"></span>
        open to senior SWE and ML/AI roles
      </p>
      <h1 id="intro" class="text-4xl font-semibold tracking-tight text-balance sm:text-5xl">
        Mert Metin<span class="text-ink-3">,</span><br>
        <span class="text-ink-2">Senior Software Engineer.</span>
      </h1>
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-ink-2 text-pretty">
        I build full-stack web and mobile products end to end (APIs, apps, payments, cloud) and I
        measure whether they work. Search and machine learning are my favourite problems.
      </p>
      <div class="mt-8 flex flex-wrap gap-3 font-mono text-sm">
        <%= link_to "#work", class: "rounded-md bg-accent px-4 py-2.5 font-semibold text-paper hover:brightness-110" do %>./view-work<% end %>
        <%= link_to "https://github.com/mertmetin", class: "rounded-md border border-line bg-card px-4 py-2.5 font-medium hover:border-ink-3", rel: "me" do %>git clone github.com/mertmetin<% end %>
      </div>
    </div>

    <%# Terminal: interactive with JavaScript, a static transcript without it. %>
    <figure class="overflow-hidden rounded-xl border border-line bg-card shadow-2xl shadow-black/20"
            aria-label="An interactive terminal: type help to see the commands"
            data-controller="terminal"
            data-terminal-projects-value="<%= @projects.map { |p| { slug: p.slug, name: p.name, tagline: p.tagline, stat: p.stat, stat_label: p.stat_label, url: project_path(p) } }.to_json %>"
            data-terminal-github-url-value="https://github.com/mertmetin"
            data-action="click->terminal#focus">
      <div class="flex items-center gap-2 border-b border-line px-4 py-3">
        <span class="size-3 rounded-full bg-[#ff5f57]" aria-hidden="true"></span>
        <span class="size-3 rounded-full bg-[#febc2e]" aria-hidden="true"></span>
        <span class="size-3 rounded-full bg-[#28c840]" aria-hidden="true"></span>
        <span class="ml-2 font-mono text-xs text-ink-3">mert@ottawa: ~</span>
      </div>

      <div class="h-[19rem] font-mono text-[12.5px] leading-6 text-ink-2 sm:text-[13px]">
        <div data-terminal-target="output" class="h-[calc(100%-2.75rem)] overflow-y-auto px-5 pt-4 break-words" role="log" aria-live="polite" hidden></div>
        <form data-terminal-target="form" data-action="submit->terminal#submit" class="flex items-center gap-2 px-5 pb-4" hidden>
          <label for="terminal-input" class="text-accent-ink">$</label>
          <input id="terminal-input" data-terminal-target="input" data-action="keydown->terminal#keydown"
                 class="min-w-0 flex-1 bg-transparent text-ink caret-accent outline-none placeholder:text-ink-3"
                 autocomplete="off" autocapitalize="off" spellcheck="false" enterkeyhint="go"
                 placeholder="type help" aria-label="Terminal command">
        </form>

        <div data-terminal-target="game" class="h-full px-4 pt-3 pb-2" hidden>
          <div class="mb-2 flex items-center justify-between text-xs text-ink-3">
            <span>🐇 rabbit run · delivered <span data-terminal-target="score" class="text-accent-ink">0</span></span>
            <span class="hidden sm:inline">arrows / WASD · esc to quit</span>
            <span class="sm:hidden">swipe · <button type="button" class="underline" data-action="terminal#quitGame">quit</button></span>
          </div>
          <canvas data-terminal-target="canvas" class="block w-full touch-none rounded-md"
                  data-action="touchstart->terminal#touchstart touchmove->terminal#touchmove"
                  aria-label="Rabbit Run game board"></canvas>
        </div>

      <pre data-terminal-target="static" class="overflow-x-auto px-5 pt-4 whitespace-pre-wrap lg:whitespace-pre"><span class="text-accent-ink">$</span> <span class="text-ink">whoami</span>
Mert Metin · Senior Software Engineer · Ottawa, ON

<span class="text-accent-ink">$</span> <span class="text-ink">cat stack.txt</span>
<span class="text-cyan">TypeScript</span>  <span class="text-cyan">Python</span>  <span class="text-cyan">Ruby</span>  <span class="text-cyan">PHP</span>
<span class="text-violet">Next.js</span>  <span class="text-violet">React Native</span>  <span class="text-violet">Rails</span>  <span class="text-violet">FastAPI</span>
<span class="text-amber">AWS</span>  <span class="text-amber">Docker</span>  <span class="text-amber">MySQL</span>  <span class="text-amber">Stripe</span>

<span class="text-accent-ink">$</span> <span class="text-ink">ls ~/projects</span>
<% @projects.each do |p| %><%= link_to "#{p.slug}/", project_path(p), class: "text-cyan hover:underline" %>  <% end %>

<span class="text-accent-ink">$</span> <span class="cursor" aria-hidden="true"></span></pre>
      </div>
    </figure>
  </div>
</section>

<%# ------------------------------------------------------------------ work %>
<section id="work" class="scroll-mt-20" aria-labelledby="work-heading">
  <h2 id="work-heading" class="mb-6 font-mono text-sm text-ink-3"><span class="text-accent-ink">//</span> selected work</h2>
  <div class="grid gap-4 md:grid-cols-2">
    <% @projects.each do |project| %>
      <%= link_to project_path(project), class: "group flex flex-col rounded-xl border border-line bg-card p-5 transition hover:border-ink-3 focus-visible:outline-2 focus-visible:outline-accent" do %>
        <div class="flex items-center justify-between gap-3 font-mono text-[13px]">
          <span class="flex min-w-0 items-center gap-2 text-cyan">
            <svg viewBox="0 0 16 16" class="size-4 shrink-0 fill-ink-3" aria-hidden="true"><path d="M2 2.5A2.5 2.5 0 0 1 4.5 0h8.75a.75.75 0 0 1 .75.75v12.5a.75.75 0 0 1-.75.75h-2.5a.75.75 0 0 1 0-1.5h1.75v-2h-8a1 1 0 0 0-.714 1.7.75.75 0 1 1-1.072 1.05A2.495 2.495 0 0 1 2 11.5Zm10.5-1h-8a1 1 0 0 0-1 1v6.708A2.486 2.486 0 0 1 4.5 9h8ZM5 12.25a.25.25 0 0 1 .25-.25h3.5a.25.25 0 0 1 .25.25v3.25a.25.25 0 0 1-.4.2l-1.45-1.087a.249.249 0 0 0-.3 0L5.4 15.7a.25.25 0 0 1-.4-.2Z"/></svg>
            <span class="truncate"><%= project.repo %></span>
          </span>
          <span class="shrink-0 rounded-full border border-line px-2 py-0.5 text-[11px] text-ink-3"><%= project.private? ? "Private" : "Public" %></span>
        </div>

        <h3 class="mt-4 text-lg font-semibold tracking-tight"><%= project.name %></h3>
        <p class="mt-1 text-sm text-ink-2"><%= project.tagline %></p>

        <div class="mt-5 rounded-lg border border-line bg-paper/60 px-4 py-3">
          <p class="font-mono text-2xl font-semibold tracking-tight tabular-nums text-accent-ink"><%= project.stat %></p>
          <p class="mt-0.5 text-xs text-ink-3"><%= project.stat_label %></p>
        </div>

        <div class="mt-5 flex items-center justify-between gap-3 font-mono text-xs text-ink-3">
          <span class="flex items-center gap-1.5">
            <span class="size-2.5 rounded-full" style="background: <%= project.language_color %>" aria-hidden="true"></span>
            <%= project.language %>
          </span>
          <span><%= project.year %></span>
          <span class="text-ink-2 group-hover:text-accent-ink">README.md <span aria-hidden="true">→</span></span>
        </div>
      <% end %>
    <% end %>
  </div>
</section>

<%# ------------------------------------------------------------------ stack %>
<section id="stack" class="scroll-mt-20 pt-24" aria-labelledby="stack-heading">
  <h2 id="stack-heading" class="mb-6 font-mono text-sm text-ink-3"><span class="text-accent-ink">//</span> stack</h2>
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    <% {
         "Languages" => %w[TypeScript Python Ruby PHP SQL],
         "Frameworks" => ["Next.js", "React Native", "Expo", "Rails", "FastAPI", "Laravel"],
         "Data & ML" => ["MySQL", "Prisma", "scikit-learn", "pandas", "Embeddings", "LLM APIs"],
         "Infra" => ["AWS ECS / RDS / S3", "Docker", "GitHub Actions", "Stripe", "Twilio"]
       }.each do |group, items| %>
      <div class="rounded-xl border border-line bg-card p-5">
        <h3 class="font-mono text-xs uppercase tracking-wider text-ink-3"><%= group %></h3>
        <ul class="mt-3 space-y-1.5 text-sm">
          <% items.each do |item| %>
            <li class="flex items-center gap-2"><span class="font-mono text-accent-ink" aria-hidden="true">›</span><%= item %></li>
          <% end %>
        </ul>
      </div>
    <% end %>
  </div>
</section>

<%# ------------------------------------------------------------------ about %>
<section id="about" class="scroll-mt-20 pt-24" aria-labelledby="about-heading">
  <h2 id="about-heading" class="mb-6 font-mono text-sm text-ink-3"><span class="text-accent-ink">//</span> about</h2>
  <div class="grid gap-10 md:grid-cols-[2fr_1fr]">
    <div class="space-y-5 text-lg leading-relaxed text-ink-2">
      <p>
        I like taking a product from an empty repo to something real people use: designing the data
        model, building the API and the apps on top of it, wiring up payments and notifications, and
        deploying it all with tests and CI behind it.
      </p>
      <p>
        I also care about measuring whether things actually work. When I revisited my 2014 product search
        and my 2019 University of Ottawa thesis, the most useful thing I did was set up honest evaluations,
        which turned up bugs, models that had never learned anything, and an "upgrade" that made results worse.
      </p>
      <p>
        Outside engineering I run a real-estate practice in Ottawa on software I wrote, so I'm used to
        being my own most demanding user.
      </p>
    </div>
    <dl class="h-fit space-y-4 rounded-xl border border-line bg-card p-5 font-mono text-sm">
      <div><dt class="text-xs text-ink-3">location</dt><dd>Ottawa, ON · remote OK</dd></div>
      <div><dt class="text-xs text-ink-3">looking_for</dt><dd>Senior SWE · ML/AI engineering</dd></div>
      <div><dt class="text-xs text-ink-3">education</dt><dd>University of Ottawa</dd></div>
      <div><dt class="text-xs text-ink-3">github</dt><dd><%= link_to "@mertmetin", "https://github.com/mertmetin", class: "text-cyan hover:underline", rel: "me" %></dd></div>
    </dl>
  </div>
</section>
